<?xml version="1.0" encoding="UTF-8"?>
<!-- Jakarta JAXB (3.0) bindings. The old jaxb2-commons namespace:prefix customisation was removed with the
     javax-only jaxb2-namespace-prefix plugin (see pom NOTE) — it only set the output XML namespace prefix for xsi,
     not compilation; re-add a Jakarta-compatible namespace-prefix plugin (or apply at marshal time in the
     event-processor) if the XHIBIT XML output requires the custom prefixes. -->
<jaxb:bindings xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               xmlns:xs="http://www.w3.org/2001/XMLSchema"
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               jaxb:version="3.0">

  <jaxb:globalBindings>
<!--    <jaxb:serializable uid="1"/>-->
    <xjc:javaType xmlType="xs:date" name="java.time.LocalDate"
                  adapter="uk.gov.moj.cpp.hearing.domain.xhibit.LocalDateAdapter"/>
  </jaxb:globalBindings>

</jaxb:bindings>
