<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>uk.gov.moj.cpp.hearing</groupId>
        <artifactId>hearing-domain</artifactId>
        <version>25.104.4-M4-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>hearing-domain-xhibit</artifactId>

    <build>
        <plugins>
            <!-- Jakarta successor of the deprecated org.jvnet.jaxb2.maven2:maven-jaxb2-plugin; emits jakarta.xml.bind.
                 The old -Xnamespace-prefix add-on (jaxb2-namespace-prefix, javax-only) was dropped — it only affects
                 the XHIBIT XML namespace-prefix output of the generated classes, not compilation. If the XHIBIT XML
                 output requires the custom prefixes, apply them at marshal time (glassfish NamespacePrefixMapper in
                 the event-processor), mirroring the listing migration. -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>4.0.8</version>
                <configuration>
                    <strict>false</strict>
                    <args>
                        <arg>-XautoNameResolution</arg>
                        <arg>-extension</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-web-page</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaDirectory>src/main/resources/xhibit/xsd/iwp</schemaDirectory>
                            <generatePackage>uk.gov.moj.cpp.hearing.domain.xhibit.generated.iwp
                            </generatePackage>
                            <generateDirectory>${project.build.directory}/generated-sources/xjc-iwp
                            </generateDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-public-display</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaDirectory>src/main/resources/xhibit/xsd/pd</schemaDirectory>
                            <generatePackage>uk.gov.moj.cpp.hearing.domain.xhibit.generated.pd
                            </generatePackage>
                            <generateDirectory>${project.build.directory}/generated-sources/xjc-pd
                            </generateDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
    </dependencies>
</project>
