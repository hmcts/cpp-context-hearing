<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <!-- Change the primary key order to (hearing_id, id) to improve performance. -->
    <!-- Requires no foreign keys referencing ha_target. -->
    <changeSet id="137" author="hearing" logicalFilePath="137-reverse-primary-key-order-ha_target.xml">
        <preConditions onFail="HALT" onError="HALT">
            <!-- Change the primary key order to (hearing_id, id) for better performance. -->
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM pg_constraint c
                JOIN pg_class t ON t.oid = c.confrelid
                WHERE t.relname = 'ha_target' AND c.contype = 'f';
            </sqlCheck>
        </preConditions>
        <sql splitStatements="true" endDelimiter=";">
            -- Drop and recreate the primary key in the new column order
            ALTER TABLE ha_target DROP CONSTRAINT ha_target_pkey;
            ALTER TABLE ha_target ADD CONSTRAINT ha_target_pkey PRIMARY KEY (hearing_id, id);
        </sql>
    </changeSet>

</databaseChangeLog>
