{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/hearing/courts/get-hearings-check-in.json",
  "type": "object",
  "properties": {
    "hearingSummaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/hearingSummary"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "hearingSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
        },
        "courtCentre": {
          "$ref": "#/definitions/courtCentre"
        },
        "prosecutionCaseSummaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/prosecutionCaseSummary"
          }
        },
        "courtApplicationSummaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/courtApplicationSummary"
          }
        }
      }
    },
    "courtApplicationSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
        },
        "applicationReference": {
          "type": "string"
        },
        "caseSummaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/courtApplicationCaseSummary"
          }
        },
        "applicant": {
          "$ref": "#/definitions/courtApplicationPartySummary"
        },
        "respondents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/courtApplicationPartySummary"
          }
        },
        "subject": {
          "$ref": "#/definitions/courtApplicationPartySummary"
        },
        "type": {
          "description": "The type of application made to court for judicial decision.  Taken from reference data",
          "type": "object",
          "properties": {
            "type": {
              "description": "The CJS Title for the court application type",
              "type": "string"
            },
            "typeWelsh": {
              "type": "string"
            },
            "legislation": {
              "type": "string"
            }
          }
        }
      }
    },
    "courtApplicationPartySummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
        },
        "firstName": {
          "description": "The person forename",
          "type": "string"
        },
        "middleName": {
          "description": "The person middle name",
          "type": "string"
        },
        "lastName": {
          "description": "The person last name",
          "type": "string"
        },
        "organisationName": {
          "description": "The organisation name",
          "type": "string"
        }
      }
    },
    "courtApplicationCaseSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
        },
        "prosecutionCaseIdentifier": {
          "$ref": "#/definitions/prosecutionCaseIdentifier"
        }
      }
    },
    "courtCentre": {
      "type": "object",
      "properties": {
        "roomName": {
          "description": "The name of the court room",
          "type": "string"
        }
      }
    },
    "prosecutionCaseSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
        },
        "prosecutionCaseIdentifier": {
          "$ref": "#/definitions/prosecutionCaseIdentifier"
        },
        "defendants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/defendant"
          }
        }
      }
    },
    "prosecutionCaseIdentifier": {
      "type": "object",
      "properties": {
        "caseURN": {
          "description": "The case URN",
          "type": "string"
        },
        "prosecutionAuthorityReference": {
          "description": "The prosecuting authorities reference for the defendant for the given case",
          "type": "string"
        }
      }
    },
    "defendant": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
        },
        "firstName": {
          "description": "The person forename",
          "type": "string"
        },
        "middleName": {
          "description": "The person middle name",
          "type": "string"
        },
        "lastName": {
          "description": "The person last name",
          "type": "string"
        },
        "organisationName": {
          "description": "The organisation name",
          "type": "string"
        }
      }
    }
  }
}
