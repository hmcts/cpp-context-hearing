  "type": "object",
  "properties": {
    "offenceBailStatuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offenceId": {
            "type": "string"
          },
          "bailStatusId": {
            "type": "string"
          },
          "bailStatusCode": {
            "type": "string"
          },
          "bailStatusDesc": {
            "type": "string"
          }
        },
        "required": [
