{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/json/schemas/hearing/hearing.event.release-provisional-hearing-slots.json",
  "type": "object",
  "properties": {
    "hearingId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "bookingIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "enum": ["RELEASED_BY_USER", "DROPPED_FROM_DRAFT"]
    }
  },
  "required": ["hearingId", "bookingIds", "reason"],
  "additionalProperties": false
}
