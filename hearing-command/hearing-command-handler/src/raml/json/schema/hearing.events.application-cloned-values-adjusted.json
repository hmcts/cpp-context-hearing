{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/json/schemas/hearing/hearing.events.application-cloned-values-adjusted.json",
  "description": "Sharing a STAT DEC application's result cleared (granted) or restored (not granted) the plea, verdict and conviction date cloned onto its offences from an earlier hearing.",
  "type": "object",
  "properties": {
    "hearingId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "hearingDay": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/datePattern"
    },
    "sharedTime": {
      "type": "string"
    },
    "applicationId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "applicationTypeCode": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": ["GRANTED", "NOT_GRANTED"]
    },
    "action": {
      "type": "string",
      "enum": ["CLEARED", "RESTORED"]
    },
    "offences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/adjustedOffence"
      }
    }
  },
  "required": [
    "hearingId",
    "hearingDay",
    "sharedTime",
    "applicationId",
    "outcome",
    "action",
    "offences"
  ],
  "additionalProperties": false,
  "definitions": {
    "adjustedOffence": {
      "type": "object",
      "properties": {
        "offenceId": {
          "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
        },
        "fieldsChanged": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["plea", "verdict", "convictionDate"]
          }
        },
        "previous": {
          "$ref": "#/definitions/offenceValues"
        },
        "adjusted": {
          "$ref": "#/definitions/offenceValues"
        }
      },
      "required": [
        "offenceId",
        "fieldsChanged",
        "previous",
        "adjusted"
      ],
      "additionalProperties": false
    },
    "offenceValues": {
      "type": "object",
      "properties": {
        "plea": {
          "$ref": "http://justice.gov.uk/core/courts/plea.json"
        },
        "verdict": {
          "$ref": "http://justice.gov.uk/core/courts/verdict.json"
        },
        "convictionDate": {
          "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/datePattern"
        }
      },
      "additionalProperties": false
    }
  }
}
